generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TokenType {
  EMAIL
  PHONE
  REACTIVATION
}

enum TwoFactorMethod {
  TOTP
  SMS
  EMAIL
}

enum Role {
  ADMIN
  USER
  CASHIER
}

enum AuthProvider {
  GOOGLE
  GITHUB
  FACEBOOK
  DISCORD
}

enum UserProfileStatus {
  ACTIVE
  BANNED
  DELETED
}

enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ARCHIVED
}

enum TheaterStatus {
  ACTIVE
  INACTIVE
}

enum ScreenType {
  STANDARD
  VIP
  IMAX
  THREE_D
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
  WHEELCHAIR
}

enum SeatStatus {
  ACTIVE
  MAINTENANCE
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
  FINISHED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  ABA
  KHQR
  STRIPE
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

model Account {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String?
  role                Role                 @default(USER)
  status              AccountStatus        @default(ACTIVE)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  twoFactorEnabled    Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             UserProfile?
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  twoFactorAuth       TwoFactorAuth?
  loginSessions       LoginSession[]
  uploadedFiles       File[]
  bookings            Booking[]
  seatLocks           SeatLock[]
}

model UserProfile {
  id        String            @id @default(uuid())
  accountId String            @unique
  firstName String
  lastName  String
  phone     String?           @unique
  avatarId  String?           @unique
  avatar    File?             @relation(fields: [avatarId], references: [id])
  status    UserProfileStatus
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  account   Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id                String         @id @default(uuid())
  accountId         String
  tokenHash         String
  deviceId          String?
  deviceInfo        String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime       @default(now())
  account           Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens    RefreshToken[] @relation("TokenRotation")
  sessions          LoginSession[]

  @@index([accountId])
}

model VerificationToken {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model TwoFactorAuth {
  id        String @id @default(uuid())
  accountId String @unique

  secretEncrypted String
  method          TwoFactorMethod

  backupCodesHash String?
  enabledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model LoginSession {
  id String @id @default(uuid())

  accountId      String
  refreshTokenId String

  deviceName String?
  deviceType String?

  ipAddress String?
  userAgent String?

  isActive Boolean @default(true)

  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  refreshToken RefreshToken @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([refreshTokenId])
}

model OAuthAccount {
  id             String       @id @default(uuid())
  accountId      String
  provider       AuthProvider
  providerUserId String
  providerEmail  String?
  displayName    String?
  username       String?
  avatarUrl      String?
  accessToken    String?
  refreshToken   String?
  linkedAt       DateTime     @default(now())
  lastUsedAt     DateTime?
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([accountId])
}

model File {
  id            String   @id @default(uuid())
  originalName  String
  mimeType      String
  size          Int
  url           String
  publicId      String   @unique
  description   String?
  uploaderId    String?
  posterOfMovie Movie?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  uploader      Account? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  avatarOfUser UserProfile?
  theaterOf    Theater?

  @@index([uploaderId])
}

model Movie {
  id               String      @id @default(uuid())
  title            String
  description      String?
  durationMinutes  Int
  language         String
  releaseDate      DateTime
  posterId         String?     @unique
  poster           File?       @relation(fields: [posterId], references: [id])
  trailerYoutubeId String?
  status           MovieStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showtimes Showtime[]
}

model Theater {
  id       String        @id @default(uuid())
  name     String
  phone    String?
  email    String?
  location String
  city     String
  status   TheaterStatus
  imageId  String?       @unique
  image    File?         @relation(fields: [imageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screens Screen[]
}

model Screen {
  id         String         @id @default(uuid())
  theaterId  String
  templateId String
  name       String
  type       ScreenType
  theater    Theater        @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  template   ScreenTemplate @relation(fields: [templateId], references: [id])
  seats      Seat[]
  showtimes  Showtime[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ScreenTemplate {
  id              String     @id @default(uuid())
  name            String
  type            ScreenType
  description     String?
  isActive        Boolean    @default(true)
  screenSurcharge Decimal    @default(0) @db.Decimal(10, 2)

  layouts       SeatLayout[]
  screens       Screen[]
  templateSeats ScreenTemplateSeat[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SeatLayout {
  id         String               @id @default(uuid())
  name       String
  templateId String
  template   ScreenTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  seats      ScreenTemplateSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScreenTemplateSeat {
  id       String     @id @default(uuid())
  layoutId String
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  seatRow          String
  seatNumber       Int
  posX             Int
  posY             Int
  seatType         SeatType
  screenTemplate   ScreenTemplate? @relation(fields: [screenTemplateId], references: [id])
  screenTemplateId String?

  @@unique([layoutId, seatRow, seatNumber])
}

model Seat {
  id           String        @id @default(uuid())
  screenId     String
  seatRow      String
  seatNumber   Int
  posX         Int
  posY         Int
  seatType     SeatType
  status       SeatStatus
  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]
  seatLocks    SeatLock[]

  @@unique([screenId, seatRow, seatNumber])
}

model SeatPricingRule {
  id            String   @id @default(uuid())
  seatType      SeatType @unique
  seatSurcharge Decimal  @default(0) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatLock {
  id String @id @default(uuid())

  accountId  String
  seatId     String
  showtimeId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@index([accountId])
  @@index([expiresAt])
}

model Showtime {
  id String @id @default(uuid())

  movieId  String
  screenId String

  startTime DateTime
  endTime   DateTime

  basePrice Decimal @db.Decimal(10, 2)

  status       ShowtimeStatus
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  movie        Movie          @relation(fields: [movieId], references: [id])
  screen       Screen         @relation(fields: [screenId], references: [id])
  bookings     Booking[]
  bookingSeats BookingSeat[]
  seatLocks    SeatLock[]

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

model Booking {
  id           String        @id @default(uuid())
  accountId    String
  showtimeId   String
  bookingCode  String        @unique
  totalPrice   Decimal       @db.Decimal(10, 2)
  status       BookingStatus
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  showtime     Showtime      @relation(fields: [showtimeId], references: [id])
  bookingSeats BookingSeat[]
  payment      Payment?

  @@index([accountId])
  @@index([showtimeId])
}

model BookingSeat {
  id         String   @id @default(uuid())
  bookingId  String
  seatId     String
  showtimeId String
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id])
  showtime   Showtime @relation(fields: [showtimeId], references: [id])

  @@unique([bookingId, seatId])
  @@unique([showtimeId, seatId])
  @@index([bookingId])
  @@index([seatId])
  @@index([showtimeId])
}

model Payment {
  id             String          @id @default(uuid())
  bookingId      String          @unique
  provider       PaymentProvider
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  status         PaymentStatus
  expiresAt      DateTime?
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}
